{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life OS sync v1 — propuesta de mensajes",
  "description": "Contrato propuesto. La raíz valida una petición push; las respuestas se referencian mediante $defs.",
  "$ref": "#/$defs/pushRequest",
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 0 },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "target_sets", "reps_min", "reps_max"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "target_sets": { "type": "integer", "minimum": 1, "maximum": 100 },
        "reps_min": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "reps_max": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exercises"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "exercises": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "performedSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exercise_id", "weight", "unit", "reps", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "exercise_id": { "$ref": "#/$defs/id" },
        "weight": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3})(\\.[0-9]{1,3})?$" },
        "unit": { "enum": ["kg", "lb"] },
        "reps": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "kind": { "enum": ["warmup", "work"] },
        "rir": { "type": ["integer", "null"], "minimum": 0, "maximum": 20 },
        "rest_seconds": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id", "routine_version", "routine_snapshot", "started_at", "finished_at", "sets"],
      "properties": {
        "routine_id": { "$ref": "#/$defs/id" },
        "routine_version": { "type": ["integer", "null"], "minimum": 1 },
        "routine_snapshot": { "$ref": "#/$defs/routine" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "sets": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/performedSet" } }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id", "version", "deleted", "data"],
      "properties": {
        "entity_type": { "enum": ["routine", "session"] },
        "entity_id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "deleted": { "type": "boolean" },
        "data": {}
      },
      "allOf": [
        {
          "if": { "properties": { "deleted": { "const": true } } },
          "then": { "properties": { "data": { "type": "null" } } },
          "else": {
            "if": { "properties": { "entity_type": { "const": "routine" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/routine" } } },
            "else": { "properties": { "data": { "$ref": "#/$defs/session" } } }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "entity_type", "entity_id", "base_version", "action", "data"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id" },
        "entity_type": { "enum": ["routine", "session"] },
        "entity_id": { "$ref": "#/$defs/id" },
        "base_version": { "$ref": "#/$defs/version" },
        "action": { "enum": ["upsert", "delete"] },
        "data": {}
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "delete" } } },
          "then": {
            "properties": {
              "base_version": { "minimum": 1 },
              "data": { "type": "null" }
            }
          },
          "else": {
            "if": { "properties": { "entity_type": { "const": "routine" } } },
            "then": { "properties": { "data": { "$ref": "#/$defs/routine" } } },
            "else": { "properties": { "data": { "$ref": "#/$defs/session" } } }
          }
        }
      ]
    },
    "pushRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "operations"],
      "properties": {
        "protocol_version": { "const": 1 },
        "operations": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/operation" } }
      }
    },
    "operationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "status", "record"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["applied", "conflict"] },
        "record": { "anyOf": [{ "$ref": "#/$defs/record" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "applied" } } },
          "then": { "properties": { "record": { "$ref": "#/$defs/record" } } }
        }
      ]
    },
    "pushResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "results"],
      "properties": {
        "protocol_version": { "const": 1 },
        "results": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/operationResult" } }
      }
    },
    "pullResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "changes", "next_cursor", "has_more"],
      "properties": {
        "protocol_version": { "const": 1 },
        "changes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/record" } },
        "next_cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
        "has_more": { "type": "boolean" }
      }
    }
  }
}

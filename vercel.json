{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lifeos-pc4x.vercel.app" }],
      "destination": "https://lifeos-sigma-sooty.vercel.app/:path*",
      "permanent": false
    }
  ],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "server": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": { "app.py": { "includeFiles": "contracts/**" } }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/health", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
